{
  "compilerOptions": {
    "declaration": false,
    "esModuleInterop": true,
    "jsx": "react",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "commonjs",
    "moduleResolution": "node",
    "noImplicitReturns": true,
    "outDir": "./lib",
    "resolveJsonModule": true,
    "rootDir": "./src",
    "sourceMap": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2020"
  },
  "exclude": [
    "node_modules",
    "lib"
  ],
  "include": [
    "src"
  ]
}
