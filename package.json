{
  "name": "local-addon-mkcert",
  "productName": "mkcert SSL",
  "version": "0.1.9",
  "author": "Mario Peischl",
  "description": "Creates locally trusted mkcert certificates for Local sites on macOS.",
  "keywords": [
    "local-addon",
    "mkcert",
    "ssl",
    "https"
  ],
  "bgColor": "#2F5D50",
  "icon": "icon.svg",
  "slug": "mkcert-ssl",
  "main": "lib/main.js",
  "renderer": "lib/renderer.js",
  "license": "MIT",
  "homepage": "https://github.com/electricarts/local-addon-mkcert#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/electricarts/local-addon-mkcert.git"
  },
  "bugs": {
    "url": "https://github.com/electricarts/local-addon-mkcert/issues"
  },
  "engines": {
    "local-by-flywheel": ">=9.0.0"
  },
  "files": [
    "lib/",
    "!lib/**/*.test.js",
    "!lib/**/*.test.js.map",
    "icon.svg",
    "README.md",
    "RISKS.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "node -e \"require('fs').rmSync('lib', { recursive: true, force: true })\"",
    "prepare": "npm run build",
    "test": "npm run build && node --test lib/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@getflywheel/local": "10.1.1",
    "@types/node": "^22.17.0",
    "@types/react": "^19.1.9",
    "typescript": "^5.8.3"
  }
}
